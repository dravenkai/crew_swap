@font-face {font-family:'DM Sans';font-style:normal;font-weight:400;font-display:swap;src:url('assets/fonts/dm-sans-400.ttf') format('truetype');}
@font-face {font-family:'DM Sans';font-style:normal;font-weight:500;font-display:swap;src:url('assets/fonts/dm-sans-500.ttf') format('truetype');}
@font-face {font-family:'DM Sans';font-style:normal;font-weight:600;font-display:swap;src:url('assets/fonts/dm-sans-600.ttf') format('truetype');}
@font-face {font-family:'DM Sans';font-style:normal;font-weight:700;font-display:swap;src:url('assets/fonts/dm-sans-700.ttf') format('truetype');}
:root {
  --p-bg: #f7f9fa; --p-surface: #ecf0f2; --p-ink: #1f3038; --p-muted: #5d6b72;
  --p-accent: #0d7480; --p-accent-ink: #ffffff; --p-action: #0d7480; --p-action-ink: #ffffff;
  --p-inv-bg: #1f3038; --p-inv-surface: #2c3c44; --p-inv-ink: #f7f9fa; --p-inv-muted: #9ea7ab;
  --p-inv-accent: #f7f9fa; --p-inv-accent-ink: #1f3038; --p-inv-action: #f7f9fa; --p-inv-action-ink: #1f3038;
  --font-display: "Funnel Display", system-ui, sans-serif;
  --font-text: "Funnel Sans", system-ui, sans-serif;
  --font-mono: "DM Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 400; --display-tracking: -0.03em; --display-tracking-xl: -0.04em; --ly-scale: 0.98;
  --bg: var(--p-bg); --ink: var(--p-ink); --action: var(--p-action);
  --text: var(--p-ink); --muted: var(--p-muted); --line: #dce3e6;
  --font: 'DM Sans', system-ui, sans-serif;
  color-scheme: light;
}
* { box-sizing: border-box; }
body { display: grid; grid-template-columns: 232px minmax(0, 1fr); margin: 0; color: var(--text); background: var(--bg); font: 16px/1.6 var(--font); }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; color: inherit; }
button:disabled { opacity: .5; cursor: not-allowed; }
a { color: var(--action); text-underline-offset: 4px; }
button, a, input, select, textarea, summary { -webkit-tap-highlight-color: transparent; }
:focus-visible { outline: 3px solid var(--action); outline-offset: 4px; }
.hidden, [hidden] { display: none !important; }
h1, h2, h3, p, figure, blockquote { margin: 0; }
h1 { font-size: clamp(32px, 3vw, 42px); line-height: 1.2; letter-spacing: -.035em; font-weight: 600; }
h2 { font-size: 22px; line-height: 1.35; letter-spacing: -.025em; font-weight: 600; }
h3 { font-size: 18px; line-height: 1.4; font-weight: 600; }
.skip-link { position: fixed; top: 10px; left: 10px; z-index: 100; padding: 12px 20px; background: white; transform: translateY(-160%); }
.skip-link:focus { transform: none; }
.sidebar { position: sticky; top: 0; height: 100vh; width: 232px; background: #fff; border-right: 1px solid var(--line); padding: 36px 24px 24px; display: flex; flex-direction: column; }
.brand { display: flex; align-items: center; gap: 9px; font-size: 25px; font-weight: 700; letter-spacing: -1px; color: var(--text); text-decoration: none; }
.brand-dot { width: 8px; height: 8px; background: var(--action); border-radius: 50%; }
.mission-context { margin: 38px 0 26px; font-size: 15px; font-weight: 500; }
.mission-context span { display: block; color: var(--muted); font-size: 14px; font-weight: 400; margin-top: 3px; }
nav { display: grid; gap: 8px; }
.nav-item { text-align: left; background: transparent; border: 0; border-radius: 7px; padding: 12px 16px; min-height: 48px; font-weight: 500; }
.nav-item:hover { background: var(--bg); }
.nav-item.active { background: transparent; color: #075e69; box-shadow: inset 3px 0 0 var(--action); border-radius: 0; }
.sidebar-bottom { margin-top: auto; padding-top: 32px; display: grid; gap: 4px; }
.text-button, .text-link { border: 0; background: none; padding: 10px 0; min-height: 44px; text-align: left; font-weight: 500; color: var(--action); }
.text-button { color: var(--muted); font-size: 14px; }
.text-link:hover, .text-button:hover { text-decoration: underline; text-underline-offset: 4px; }
.operator { border-top: 1px solid var(--line); margin-top: 20px; padding-top: 20px; font-size: 15px; }
.operator strong, .operator span { display: block; }
.operator span { color: var(--muted); font-size: 14px; }
main { min-width: 0; min-height: 100vh; }
.topbar { min-height: 64px; padding: 20px clamp(24px, 3.3vw, 56px); border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 14px; }
.scenario-label { font-size: 14px; }
.content { max-width: 1416px; margin: 0 auto; padding: 36px clamp(24px, 3.3vw, 56px) 24px; }
.page-title { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 34px; }
.page-title p { margin-top: 10px; color: var(--muted); font-size: 17px; }
.button { display: inline-flex; justify-content: center; align-items: center; gap: 8px; border: 1px solid transparent; border-radius: 7px; padding: 11px 18px; min-height: 48px; font-weight: 600; font-size: 15px; line-height: 1.5; text-decoration: none; }
.primary { color: #fff; background: var(--action); }
.secondary { background: #fff; border-color: #cbd5da; }
.danger { background: #9b3b31; color: white; }
.primary:hover { background: #095f69; }
.secondary:hover { background: #f0f5f6; }
.danger:hover { background: #812e26; }
.alert-banner { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 28px; margin-bottom: 32px; border: 1px solid #ecd9b6; border-radius: 10px; background: #fff8ed; }
.alert-banner h2 { font-size: 22px; color: #75501f; }
.alert-banner p { margin-top: 5px; font-size: 15px; color: #765b36; }
.alert-button { background: #fff; border-color: #cbd5da; color: var(--text); flex-shrink: 0; }
.alert-button:hover { background: #f5e9d5; }
.alert-banner.resolved { background: #eef6f3; border-color: #cbded5; }
.resolved h2, .resolved p { color: #315f50; }
.panel { background: #fff; border: 1px solid var(--line); border-radius: 10px; min-width: 0; }
.panel-header { padding: 24px 28px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
.panel-header p { margin-top: 6px; font-size: 15px; color: var(--muted); }
.overview-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 28px; align-items: stretch; }
.crew-row { width: 100%; border: 0; border-top: 1px solid var(--line); background: transparent; display: grid; grid-template-columns: 1fr auto 18px; gap: 12px; align-items: center; text-align: left; padding: 17px 28px; }
.crew-row:hover { background: #f7fafb; }
.crew-row strong { font-weight: 600; font-size: 17px; }
.crew-role { display: block; color: var(--muted); font-size: 14px; margin-top: 3px; }
.row-arrow { color: var(--muted); }
.crew-status, .task-badge { font-size: 14px; line-height: 1.4; font-weight: 500; }
.available { color: #306853; }
.review { color: #8d5b1c; }
.down { color: #67727a; }
.next-panel { display: flex; flex-direction: column; }
.next-operation { padding: 10px 28px 32px; }
.operation-time { font-size: 36px; line-height: 1.2; font-weight: 500; letter-spacing: -.025em; font-variant-numeric: tabular-nums; }
.operation-time span { display: block; font-size: 14px; color: var(--muted); font-weight: 400; letter-spacing: 0; margin-top: 10px; }
.next-operation h3 { font-size: 20px; margin-top: 26px; }
.next-operation p { color: var(--muted); margin: 10px 0 18px; }
.task-badge { display: inline-block; padding: 6px 10px; border-radius: 5px; background: #f1f5f4; }
.task-badge.review { background: #fcf3e4; }
.task-badge.down { background: #f0f2f3; }
.panel-footer { margin-top: auto; border-top: 1px solid var(--line); padding: 10px 28px; }
.health-workspace { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 28px; align-items: start; }
#crew-heading { font-size: 16px; margin: 0 0 16px; color: var(--muted); }
.crew-grid { display: grid; gap: 12px; }
.crew-card { width: 100%; text-align: left; padding: 18px 20px; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
.crew-card strong { font-size: 17px; }
.crew-card .crew-status { display: block; margin-top: 12px; }
.crew-card:hover { border-color: #8db5ba; }
.crew-card.selected { background: #eaf4f4; border-color: #6fa6ad; box-shadow: inset 3px 0 0 var(--action); }
.health-panel .panel-header { border-bottom: 1px solid var(--line); }
.detail-main { padding: 28px; }
.health-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-bottom: 36px; }
.health-metrics span { display: block; font-size: 14px; color: var(--muted); }
.health-metrics strong { display: block; font-size: 29px; font-weight: 500; line-height: 1.4; margin-top: 6px; font-variant-numeric: tabular-nums; }
.health-metrics small { font-size: 14px; font-weight: 400; color: var(--muted); }
.chart-title { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 30px; }
.chart-title span { font-size: 14px; color: var(--muted); }
.chart-area { height: 180px; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px; position: relative; border-bottom: 1px solid #becbd0; }
.chart-column { height: 100%; display: flex; align-items: end; z-index: 1; }
.chart-bar { width: 100%; position: relative; background: #9bbdc1; border-radius: 4px 4px 0 0; min-height: 1px; }
.chart-column:last-child .chart-bar { background: var(--action); }
.chart-bar span { position: absolute; bottom: calc(100% + 6px); width: 100%; text-align: center; font-size: 14px; font-variant-numeric: tabular-nums; }
.baseline { position: absolute; left: 0; right: 0; border-top: 1px dashed #527a80; }
.chart-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12px; margin-top: 10px; font-size: 13px; color: var(--muted); text-align: center; }
.sleep-evidence { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 18px 0; margin: 26px 0; font-size: 14px; overflow-wrap: anywhere; }
.sleep-evidence strong { font-weight: 500; }
.sleep-evidence p { margin: 14px 0; }
.sleep-evidence ul { padding-left: 20px; }
.sleep-evidence li { margin: 8px 0; }
summary { cursor: pointer; color: var(--action); padding: 10px 0; min-height: 44px; }
.report-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 28px; }
.report-heading span { font-size: 14px; color: var(--muted); }
.quote { margin: 16px 0 26px; font-size: 17px; color: #3e525c; }
.quote small { display: block; color: var(--muted); font-size: 14px; margin-top: 8px; }
.health-actions { display: flex; gap: 12px; flex-wrap: wrap; }
.health-footnote { margin-top: 16px; color: var(--muted); font-size: 14px; }
.version-label { font-size: 14px; color: var(--muted); }
.task { display: grid; grid-template-columns: 92px 1fr auto; align-items: center; gap: 24px; padding: 26px 28px; border-top: 1px solid var(--line); }
.task-time { font-size: 19px; font-weight: 500; font-variant-numeric: tabular-nums; }
.task-time span { display: block; font-size: 14px; color: var(--muted); font-weight: 400; margin-top: 3px; }
.task-info p { color: var(--muted); font-size: 15px; margin-top: 8px; }
.review-task { background: #fffaf3; }
.schedule-footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 24px 28px; border-top: 1px solid var(--line); }
.schedule-footer p { color: var(--muted); font-size: 15px; }
.page-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 28px; color: var(--muted); font-size: 14px; }
.page-footer .text-link { font-size: 14px; }
.log-row { display: grid; grid-template-columns: 70px 1fr; gap: 20px; border-top: 1px solid var(--line); padding: 24px 28px; }
.log-row time { color: var(--muted); font-size: 15px; }
.log-row h3 { font-size: 17px; }
.log-row p { color: var(--muted); margin-top: 8px; }
.empty { padding: 48px 28px; }
.empty strong { display: block; font-size: 20px; margin-bottom: 10px; }
.empty p { color: var(--muted); max-width: 570px; }
dialog { border: 1px solid var(--line); background: #fff; color: var(--text); width: min(650px, calc(100% - 32px)); max-height: calc(100dvh - 48px); padding: 0; border-radius: 12px; box-shadow: 0 24px 80px #162d3b26; }
dialog::backdrop { background: #172f3d66; }
.dialog-header { padding: 26px 28px 20px; display: flex; align-items: start; justify-content: space-between; gap: 16px; }
.dialog-header .eyebrow { font-size: 13px; color: var(--muted); display: block; margin-bottom: 8px; text-transform: lowercase; }
.dialog-body { padding: 0 28px 28px; }
.dialog-body>p { margin-bottom: 20px; }
.icon-button { display: inline-flex; align-items: center; justify-content: center; background: #f0f4f5; border: 0; border-radius: 6px; min-width: 44px; height: 44px; font-size: 24px; }
.dialog-actions { display: flex; gap: 12px; justify-content: flex-end; flex-wrap: wrap; margin-top: 28px; }
.field { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
.field>span { font-size: 15px; font-weight: 500; }
.field small { color: var(--muted); font-size: 14px; }
.field input:not([type=range]), .field select, .field textarea { width: 100%; min-height: 48px; border: 1px solid #bac9d0; border-radius: 6px; padding: 10px 12px; color: var(--text); background: #fff; }
.field textarea { min-height: 100px; resize: vertical; }
.field input[type=range] { min-height: 44px; accent-color: var(--action); width: 100%; }
.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.review-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 20px; background: var(--bg); margin: 20px 0; border-radius: 6px; }
.review-summary span { display: block; font-size: 14px; color: var(--muted); }
.review-summary b { display: block; font-size: 22px; margin-top: 5px; }
.choice { display: block; position: relative; padding: 18px 18px 18px 48px; margin: 12px 0; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }
.choice input { position: absolute; left: 18px; top: 23px; accent-color: var(--action); }
.choice:has(input:checked) { background: #eaf4f4; border-color: #71a6ac; }
.choice:has(input:disabled) { background: #f6f7f8; color: #63727a; cursor: default; }
.choice strong { font-size: 16px; }
.choice p, .choice em { font-size: 14px; color: var(--muted); display: block; margin-top: 5px; font-style: normal; }
.plan-notice { padding: 16px 20px; background: #fff6e8; border-radius: 6px; font-size: 15px; margin: 20px 0; }
.availability-control { display: block; padding: 16px 0; font-size: 16px; cursor: pointer; }
.availability-control input { accent-color: var(--action); width: 18px; height: 18px; vertical-align: middle; margin-right: 6px; }
.availability-control small { display: block; color: var(--muted); margin: 6px 0 0 28px; font-size: 14px; }
.packet { white-space: pre-wrap; overflow-wrap: anywhere; font: 14px/1.8 var(--font); background: var(--bg); padding: 20px; border: 1px solid var(--line); border-radius: 6px; }
.source-item { padding: 20px 0; border-top: 1px solid var(--line); }
.source-item p { color: var(--muted); margin-top: 10px; font-size: 15px; }
.toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); padding: 14px 22px; background: #1f3038; color: #fff; border-radius: 8px; max-width: calc(100% - 32px); z-index: 100; opacity: 0; pointer-events: none; font-size: 15px; }
.toast.show { opacity: 1; }
@media(max-width: 1200px) {
  .overview-grid { grid-template-columns: 1fr; }
  .health-workspace { grid-template-columns: 205px minmax(0, 1fr); gap: 20px; }
  .health-metrics { gap: 10px; }
  .health-metrics strong { font-size: 25px; }
  .chart-title { align-items: start; flex-direction: column; }
}
@media(max-width: 960px) {
  body { display: block; }
  .sidebar { position: static; height: auto; width: auto; padding: 24px; border-right: 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto; gap: 20px; }
  .mission-context { margin: 0; text-align: right; }
  nav { grid-column: 1 / -1; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .nav-item { text-align: center; padding: 12px 8px; }
  .sidebar-bottom { grid-column: 1 / -1; padding: 0; margin: 0; display: flex; justify-content: space-between; }
  .operator { display: none; }
  main { margin: 0; }
  .topbar { padding: 16px 28px; min-height: 60px; }
  .content { padding: 32px 28px 20px; }
  .health-workspace { grid-template-columns: 220px minmax(0, 1fr); }
  .overview-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
  .crew-row { grid-template-columns: 1fr 18px; gap: 6px; padding: 20px; }
  .crew-row .crew-status { grid-row: 2; }
  .crew-row .row-arrow { grid-column: 2; grid-row: 1 / 3; }
}
@media(max-width: 700px) {
  .sidebar { padding: 20px; gap: 16px; }
  .brand { font-size: 23px; }
  .mission-context { font-size: 14px; }
  .mission-context span { font-size: 13px; }
  nav { grid-template-columns: 1fr 1fr; }
  .sidebar-bottom { gap: 16px; }
  .topbar { padding: 16px 20px; display: block; }
  .topbar>span { display: block; }
  .scenario-label { margin-top: 4px; }
  .content { padding: 30px 20px 20px; }
  .page-title { display: block; margin-bottom: 28px; }
  .page-title p { font-size: 16px; }
  .page-title .button { margin-top: 22px; width: 100%; }
  .overview-grid, .health-workspace { grid-template-columns: 1fr; gap: 24px; }
  .alert-banner { display: block; padding: 22px; margin-bottom: 24px; }
  .alert-banner .button { width: 100%; margin-top: 20px; }
  .panel-header, .detail-main { padding: 22px; }
  .panel-header { flex-wrap: wrap; }
  .panel-header h2 { font-size: 21px; }
  .crew-row { grid-template-columns: 1fr 18px; padding: 20px 22px; }
  .next-operation { padding: 6px 22px 28px; }
  .panel-footer { padding: 10px 22px; }
  .crew-grid { grid-template-columns: 1fr; gap: 10px; }
  .crew-card { padding: 16px 20px; }
  .health-metrics { grid-template-columns: 1fr; gap: 16px; }
  .health-metrics>div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .health-metrics strong { margin: 0; font-size: 27px; }
  .chart-area { height: 155px; gap: 8px; }
  .chart-days { gap: 8px; font-size: 13px; }
  .chart-bar span { font-size: 13px; }
  .health-actions { flex-direction: column; }
  .health-actions .button { width: 100%; }
  .task { grid-template-columns: 1fr; gap: 12px; padding: 24px 22px; }
  .task-time { display: flex; align-items: baseline; gap: 14px; }
  .task-badge { justify-self: start; }
  .schedule-footer { display: block; padding: 22px; }
  .schedule-footer .button { width: 100%; margin-top: 18px; }
  .page-footer { flex-direction: column; align-items: start; gap: 4px; }
  .log-row { grid-template-columns: 1fr; gap: 8px; padding: 22px; }
  .dialog-header { padding: 24px 20px 18px; }
  .dialog-body { padding: 0 20px 24px; }
  .field-row { grid-template-columns: 1fr; gap: 0; }
  .dialog-actions { flex-direction: column; }
  .dialog-actions .button { width: 100%; }
  .review-summary { grid-template-columns: 1fr; }
  .review-summary>div { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
}
