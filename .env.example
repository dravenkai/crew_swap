# Copy to .env, fill a key, then restart: npm start
# Prefer Gemini for this project:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# If 503/high demand, wait a moment and retry — the server retries automatically.

# Optional OpenAI fallback:
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# CREW_SWAP_PORT=43730
